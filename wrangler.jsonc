{
  // One Worker serves the API and the built front-end (npm run build -> dist/) from the same address.
  // Cloudflare's "Deploy" step runs `npx wrangler deploy` from the repo root and finds this file.
  "name": "motionforge-ai",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No IDs or setup needed: Wrangler creates the database on the first deploy, and the Worker creates its
  // own tables the first time it runs. Uploaded images are stored in that database.
  "d1_databases": [{ "binding": "DB", "database_name": "motionforge" }],
  // Cloudflare's built-in AI: image generation and understanding prompts. No key or account needed;
  // it is billed to your Cloudflare account (there is a free daily allowance).
  "ai": { "binding": "AI" },
  // Optional: to keep images in an R2 bucket instead, create a bucket in the dashboard and add
  //   "r2_buckets": [{ "binding": "FILES", "bucket_name": "your-bucket-name" }],
  // Resumes generation jobs that are waiting on an AI provider.
  "triggers": { "crons": ["* * * * *"] }
  // Settings are in the Cloudflare dashboard: Workers & Pages > motionforge-ai > Settings > Variables and Secrets.
  // Required secret:  KEY_ENCRYPTION_SECRET   (openssl rand -base64 32)   - without it, saving API keys is switched off.
  // Optional:         see DEPLOY.md (Stripe, Replicate, OpenAI, Resend, ALLOWED_ORIGIN, APP_URL).
}
